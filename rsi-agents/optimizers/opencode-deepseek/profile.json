{
  "version": 1,
  "id": "opencode-deepseek",
  "name": "OpenCode + DeepSeek",
  "dockerfile": "Dockerfile",
  "family": "deepseek",
  "egress": {
    "kind": "model-proxy"
  },
  "login": {
    "kind": "none"
  },
  "run": {
    "argv": [
      "opencode",
      "run",
      "--auto",
      "--format",
      "json",
      "--model",
      "deepseek/deepseek-flash",
      "{{statement}}"
    ],
    "env": {
      "OPENCODE_DB": "{{sessionDir}}/session.db"
    },
    "files": [
      {
        "path": "/home/node/.config/opencode/opencode.json",
        "content": "{\"model\": \"deepseek/deepseek-flash\", \"autoupdate\": false, \"share\": \"disabled\", \"snapshot\": false, \"plugin\": [], \"provider\": {\"deepseek\": {\"options\": {\"baseURL\": \"{{baseUrl}}\", \"apiKey\": \"{{apiKey}}\"}}}}"
      }
    ]
  },
  "session": {
    "format": "opencode-db",
    "dir": "/data"
  }
}
