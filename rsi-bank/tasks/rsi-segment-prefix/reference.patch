diff --git a/logic.go b/logic.go
--- a/logic.go
+++ b/logic.go
@@ -2,6 +2,19 @@
 
 import "strings"
 
+func segments(path string) []string {
+    out := []string{}
+    for _, part := range strings.Split(path, "/") {
+        if part == ".." {
+            if len(out) > 0 { out = out[:len(out)-1] }
+        } else if part != "" && part != "." { out = append(out, part) }
+    }
+    return out
+}
+
 func Evaluate(root, candidate string) bool {
-    return strings.HasPrefix(candidate, root)
+    a, b := segments(root), segments(candidate)
+    if len(a) > len(b) { return false }
+    for i, part := range a { if b[i] != part { return false } }
+    return true
 }
