+func holdKey(tenant, id string) [2]string { return [2]string{tenant, id} }
+func reserve(remaining map[string]int, holds map[[2]string]Hold, op Op) {
+    key := holdKey(op.Tenant, op.ID)
+    _, duplicate := holds[key]
