diff --git a/inventory/quantities.py b/inventory/quantities.py
--- a/inventory/quantities.py
+++ b/inventory/quantities.py
@@ -1,4 +1,4 @@
-from decimal import Decimal,InvalidOperation
+from decimal import Decimal,InvalidOperation,localcontext
 
 def number(value):
     if isinstance(value,bool):
@@ -14,9 +14,26 @@
 def render(value):
     if not value:
         return '0'
-    return format(value.normalize(),'f')
+    text=format(value,'f')
+    return text.rstrip('0').rstrip('.') if '.' in text else text
 
 def convert(value,unit,catalog):
     if unit not in catalog:
         raise ValueError('unit')
-    return number(value)*number(catalog[unit])
+    left,right=number(value),number(catalog[unit])
+    with localcontext() as context:
+        context.prec=max(1,len(left.as_tuple().digits)+len(right.as_tuple().digits))
+        return left*right
+
+def add(left,right):
+    a,b=left.as_tuple(),right.as_tuple()
+    exponent=min(a.exponent,b.exponent)
+    precision=max(len(a.digits)+a.exponent-exponent,len(b.digits)+b.exponent-exponent)+1
+    with localcontext() as context:
+        context.prec=max(1,precision)
+        return left+right
+
+def subtract(left,right):
+    sign,digits,exponent=right.as_tuple()
+    opposite=Decimal((1-sign,digits,exponent))
+    return add(left,opposite)
