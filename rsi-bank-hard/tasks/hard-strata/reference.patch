-  if winner>=0 {s:=input[winner];if len(out)>0&&out[len(out)-1].End==a&&out[len(out)-1].Ordinal==winner{out[len(out)-1].End=b}else{out=append(out,Piece{a,b,winner,s.Sequence,s.Value,s.Tombstone})}}
