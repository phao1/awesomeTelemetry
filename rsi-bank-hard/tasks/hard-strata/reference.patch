diff --git a/winners.go b/winners.go
--- a/winners.go
+++ b/winners.go
@@ -1 +1,33 @@
 package workspace
+type winnerHeap struct { ids []int; input []Span; compare Compare }
+func (h *winnerHeap) better(a,b int) bool {
+ cmp:=h.compare(h.input[a].Sequence,h.input[b].Sequence)
+ if cmp!=0 {return cmp>0}
+ return a<b
+}
+func (h *winnerHeap) push(id int) {
+ h.ids=append(h.ids,id)
+ i:=len(h.ids)-1
+ for i>0 {
+  p:=(i-1)/2
+  if !h.better(h.ids[i],h.ids[p]) {break}
+  h.ids[i],h.ids[p]=h.ids[p],h.ids[i]
+  i=p
+ }
+}
+func (h *winnerHeap) pop() {
+ last:=len(h.ids)-1
+ h.ids[0]=h.ids[last]
+ h.ids=h.ids[:last]
+ i:=0
+ for {
+  left:=2*i+1
+  if left>=len(h.ids){return}
+  best:=left
+  right:=left+1
+  if right<len(h.ids)&&h.better(h.ids[right],h.ids[left]) {best=right}
+  if !h.better(h.ids[best],h.ids[i]){return}
+  h.ids[i],h.ids[best]=h.ids[best],h.ids[i]
+  i=best
+ }
+}
