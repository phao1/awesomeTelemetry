+  message:=b.queue[0]
+  b.queue=b.queue[1:]
+  b.next++
+  token:=b.next
+  reservation:=&leaseState{message:message,waiter:w,token:token}
+  b.held[token]=reservation
+  w.token=token
+  w.state="reserved"
+  b.sim.After(0,func(){
