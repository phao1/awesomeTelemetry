diff --git a/resolve/imports.mjs b/resolve/imports.mjs
--- a/resolve/imports.mjs
+++ b/resolve/imports.mjs
@@ -1,8 +1,11 @@
 import { normalize,directory,join } from '../paths.mjs';
 export function resolveImport(owner,request,aliases={}) {
   if(request.startsWith('.')) return join(directory(owner),request);
-  for(const [alias,path] of Object.entries(aliases)) {
-    if(request.startsWith(alias)) return normalize(path+request.slice(alias.length));
+  const matching=Object.keys(aliases).filter(alias=>request===alias||request.startsWith(alias+'/'));
+  matching.sort((a,b)=>b.length-a.length||a.localeCompare(b));
+  if(matching.length) {
+    const alias=matching[0];
+    return normalize(aliases[alias]+request.slice(alias.length));
   }
   return normalize(request);
 }
diff --git a/digest.mjs b/digest.mjs
--- a/digest.mjs
+++ b/digest.mjs
@@ -1,4 +1,10 @@
 import {createHash} from 'node:crypto';
 export function digest(parts) {
-  return createHash('sha256').update(parts.join('')).digest('hex');
+  const hash=createHash('sha256');
+  for(const part of parts) {
+    const bytes=Buffer.from(part,'utf8');
+    hash.update(String(bytes.length)+':');
+    hash.update(bytes);
+  }
+  return hash.digest('hex');
 }
diff --git a/cache/key.mjs b/cache/key.mjs
