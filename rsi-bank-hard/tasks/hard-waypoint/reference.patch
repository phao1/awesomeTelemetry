+  case "test":
+   actual,e:=lookup(root,path)
+   if e!=nil {return nil,e}
+   if !reflect.DeepEqual(actual,op.Value) {return nil,fmt.Errorf("test")}
+  case "add","replace","remove":
+   root,err=edit(root,path,op.Value,op.Op)
