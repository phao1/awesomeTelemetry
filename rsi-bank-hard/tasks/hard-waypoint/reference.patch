 import "fmt"
+func clone(value any) any {
+ switch v:=value.(type) {
+ case map[string]any:
+  out:=make(map[string]any,len(v))
+  for key,item:=range v { out[key]=clone(item) }
+  return out
+ case []any:
+  out:=make([]any,len(v))
+  for i,item:=range v { out[i]=clone(item) }
+  return out
+ default: return value
+ }
+}
 func lookup(root any,path []string) (any,error) {
  value:=root
  for _,key:=range path {
-  object,ok:=value.(map[string]any)
-  if !ok { return nil,fmt.Errorf("object") }
-  value=object[key]
+  switch current:=value.(type) {
+  case map[string]any:
+   next,ok:=current[key]
+   if !ok {return nil,fmt.Errorf("missing")}
+   value=next
+  case []any:
+   i,err:=index(key,len(current),false)
+   if err!=nil {return nil,err}
+   value=current[i]
+  default: return nil,fmt.Errorf("container")
+  }
  }
  return value,nil
 }
+func mergeObject(destination map[string]any,patch map[string]any) map[string]any {
+ for key,value:=range patch {
+  if value==nil {
+   delete(destination,key)
+   continue
+  }
+  incoming,object:=value.(map[string]any)
+  if object {
+   old,exists:=destination[key].(map[string]any)
+   if !exists {old=make(map[string]any)}
+   destination[key]=mergeObject(old,incoming)
+  } else {
+   destination[key]=clone(value)
+  }
+ }
+ return destination
+}
 func edit(root any,path []string,value any,mode string) (any,error) {
- if len(path)==0 {return value,nil}
- object,ok:=root.(map[string]any);if !ok{return nil,fmt.Errorf("object")}
- if len(path)==1 {if mode=="remove"{delete(object,path[0])}else{object[path[0]]=value};return object,nil}
- child,err:=edit(object[path[0]],path[1:],value,mode);if err!=nil{return nil,err};object[path[0]]=child;return object,nil
+ if len(path)==0 {
+  if mode=="remove" {return nil,nil}
+  return clone(value),nil
+ }
+ token:=path[0]
+ leaf:=len(path)==1
+ switch current:=root.(type) {
+ case map[string]any:
+  old,exists:=current[token]
+  if !exists && (!leaf || mode!="add") {return nil,fmt.Errorf("missing")}
+  if leaf {
+   if mode=="remove" {delete(current,token)} else {current[token]=clone(value)}
+  } else {
+   child,err:=edit(old,path[1:],value,mode)
+   if err!=nil {return nil,err}
+   current[token]=child
+  }
+  return current,nil
+ case []any:
+  i,err:=index(token,len(current),leaf && mode=="add")
+  if err!=nil {return nil,err}
+  if !leaf {
+   child,err:=edit(current[i],path[1:],value,mode)
+   if err!=nil {return nil,err}
+   current[i]=child
+   return current,nil
+  }
+  switch mode {
+  case "add":
+   current=append(current,nil)
+   copy(current[i+1:],current[i:len(current)-1])
+   current[i]=clone(value)
+  case "remove":
+   current=append(current[:i],current[i+1:]...)
+  default: current[i]=clone(value)
+  }
+  return current,nil
+ default: return nil,fmt.Errorf("container")
+ }
 }
