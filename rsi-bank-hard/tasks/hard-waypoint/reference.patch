+  switch op.Op {
+  case "merge":
+   actual,e:=lookup(root,path)
+   if e!=nil {return nil,e}
+   object,ok:=actual.(map[string]any)
+   patch,valid:=op.Value.(map[string]any)
+   if !ok||!valid {return nil,fmt.Errorf("merge object")}
+   root,err=edit(root,path,mergeObject(object,patch),"replace")
