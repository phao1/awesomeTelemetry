+  case "copy","move":
+   from,e:=pointer(op.From)
+   if e!=nil {return nil,e}
+   actual,e:=lookup(root,from)
+   if e!=nil {return nil,e}
+   if op.Op=="move" {
+    if ancestor(from,path) {return nil,fmt.Errorf("ancestor")}
+    if reflect.DeepEqual(from,path) {continue}
+    root,err=edit(root,from,nil,"remove")
+    if err!=nil {return nil,err}
