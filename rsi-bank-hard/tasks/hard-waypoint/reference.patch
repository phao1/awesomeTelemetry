--- a/pointer.go
+++ b/pointer.go
@@ -1,3 +1,39 @@
 package workspace
-import "strings"
-func pointer(text string) ([]string,error) { if text=="" {return nil,nil}; return strings.Split(strings.TrimPrefix(text,"/"),"/"),nil }
+import (
+ "fmt"
+ "strconv"
+ "strings"
+)
+func pointer(text string) ([]string,error) {
+ if text=="" { return nil,nil }
+ if !strings.HasPrefix(text,"/") { return nil,fmt.Errorf("pointer") }
+ parts:=strings.Split(text[1:],"/")
+ for i,part:=range parts {
+  var out strings.Builder
+  for j:=0;j<len(part);j++ {
+   if part[j]!='~' { out.WriteByte(part[j]); continue }
+   j++
+   if j>=len(part) { return nil,fmt.Errorf("escape") }
+   switch part[j] {
+   case '0': out.WriteByte('~')
+   case '1': out.WriteByte('/')
+   default: return nil,fmt.Errorf("escape")
+   }
+  }
+  parts[i]=out.String()
+ }
+ return parts,nil
+}
+func index(token string,length int,appendOK bool) (int,error) {
+ if token=="-" && appendOK { return length,nil }
+ if token=="" || (len(token)>1 && token[0]=='0') { return 0,fmt.Errorf("index") }
+ for _,c:=range token { if c<'0'||c>'9' { return 0,fmt.Errorf("index") } }
+ n,err:=strconv.Atoi(token)
+ if err!=nil || n<0 || n>length || (!appendOK && n==length) { return 0,fmt.Errorf("index") }
+ return n,nil
+}
+func ancestor(from,to []string) bool {
+ if len(from)>=len(to) { return false }
+ for i:=range from { if from[i]!=to[i] { return false } }
+ return true
+}
