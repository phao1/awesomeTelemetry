diff --git a/table/lexical.py b/table/lexical.py
--- a/table/lexical.py
+++ b/table/lexical.py
@@ -1,2 +1,81 @@
-def tokenize(text):
-    return [line.split('|') for line in text.splitlines() if line and not line.startswith('#')]
+class Lexer:
+    def __init__(self):
+        self.cells=[]
+        self.cell=[]
+        self.quoted=False
+        self.in_quote=False
+        self.after_quote=False
+        self.escape=False
+        self.comment=False
+        self.skip_lf=False
+        self.started=False
+    def end_cell(self):
+        value=''.join(self.cell)
+        self.cells.append(value if self.quoted else (None if value=='~' else value))
+        self.cell=[]
+        self.quoted=False
+        self.after_quote=False
+        self.started=False
+    def end_row(self):
+        if not self.started and not self.cells and not self.cell and not self.quoted:
+            return None
+        self.end_cell()
+        row=self.cells
+        self.cells=[]
+        return row
+    def accept(self,char):
+        if self.skip_lf:
+            self.skip_lf=False
+            if char=='\n':
+                return None
+        if self.comment:
+            if char in '\r\n':
+                self.comment=False
+                self.skip_lf=char=='\r'
+            return None
+        if self.escape:
+            self.escape=False
+            escapes={'n':'\n','r':'\r','t':'\t','|':'|','\\':'\\','"':'"'}
+            if char not in escapes:
+                raise ValueError('escape')
+            self.cell.append(escapes[char])
+            return None
+        if self.in_quote:
+            if char=='\\':
+                self.escape=True
+            elif char=='"':
+                self.in_quote=False
+                self.after_quote=True
+            else:
+                self.cell.append(char)
+            return None
+        if self.after_quote:
+            if char not in '|\r\n':
+                raise ValueError('after quote')
+        if char=='#' and not self.started and not self.cells and not self.cell:
+            self.comment=True
+        elif char=='"':
+            if self.started:
+                raise ValueError('quote')
+            self.started=True
+            self.quoted=True
+            self.in_quote=True
+        elif char=='\\':
+            self.started=True
+            self.escape=True
+        elif char=='|':
+            self.end_cell()
+        elif char in '\r\n':
+            self.skip_lf=char=='\r'
+            return self.end_row()
+        else:
+            self.started=True
+            self.cell.append(char)
+        return None
+    def finish(self):
+        if self.escape or self.in_quote:
+            raise ValueError('unfinished cell')
+        if self.comment:
+            self.comment=False
+            return None
+        return self.end_row()
diff --git a/table/scopes.py b/table/scopes.py
--- a/table/scopes.py
+++ b/table/scopes.py
@@ -1,11 +1,58 @@
+from copy import deepcopy
 class Scopes:
     def __init__(self):
         self.defaults={}
+        self.frames=[]
+    def identifier(self,value):
+        if not isinstance(value,str) or not value or not all(c.isascii() and (c.isalnum() or c=='_') for c in value) or value[0].isdigit():
+            raise ValueError('identifier')
+        return value
+    def arity(self,cells,length):
+        if len(cells)!=length:
+            raise ValueError('arity')
+    def publish(self,records):
+        if self.frames:
+            self.frames[-1]['records'].extend(records)
+            return []
+        return records
     def row(self,cells):
-        if cells[0]=='row':
-            return [dict(self.defaults,**dict(zip(cells[1::2],cells[2::2])))]
-        if cells[0]=='set':
-            self.defaults[cells[1]]=cells[2]
-        return []
+        operation=cells[0]
+        if operation=='set':
+            self.arity(cells,3)
+            name=self.identifier(cells[1])
+            self.defaults[name]=cells[2]
+            return []
+        if operation=='unset':
+            self.arity(cells,2)
+            self.defaults.pop(self.identifier(cells[1]),None)
+            return []
+        if operation=='begin':
+            self.arity(cells,2)
+            name=self.identifier(cells[1])
+            self.frames.append({'name':name,'before':deepcopy(self.defaults),'records':[]})
+            return []
+        if operation in ('commit','abort'):
+            self.arity(cells,2)
+            if not self.frames or self.frames[-1]['name']!=cells[1]:
+                raise ValueError('frame')
+            frame=self.frames.pop()
+            self.defaults=frame['before']
+            if operation=='commit':
+                return self.publish(frame['records'])
+            return []
+        if operation=='row':
+            if len(cells)%2!=1:
+                raise ValueError('row pairs')
+            result=deepcopy(self.defaults)
+            seen=set()
+            for index in range(1,len(cells),2):
+                name=self.identifier(cells[index])
+                if name in seen:
+                    raise ValueError('duplicate')
+                seen.add(name)
+                result[name]=cells[index+1]
+            return self.publish([result])
+        raise ValueError('command')
     def finish(self):
-        pass
+        if self.frames:
+            raise ValueError('open frame')
